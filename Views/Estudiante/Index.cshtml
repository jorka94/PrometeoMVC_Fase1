@model IEnumerable<PrometeoMVC.Models.Proyecto>
@{ ViewBag.Title = "Panel Estudiante"; }

<div class="container mt-4">
    <!-- Formulario de Registro -->

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }


    <div class="card shadow-sm border-0 mb-5">
        <div class="card-header bg-white py-3">
            <h2 style="color: #48C9B0;">Estudiante - Crear proyecto</h2>
            <p class="text-muted small">Completa los campos para iniciar el proceso de evaluacion.</p>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Registrar", "Estudiante", FormMethod.Post))
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nombre del Proyecto</label>
                        <input type="text" name="NombreProyecto" class="form-control" placeholder="Ej: Sistema de Gestion..." required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Tipo de Proyecto</label>
                        <select name="Tipo" class="form-select">
                            <option value="I">Individual</option>
                            <option value="G">Grupal</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Titulo del Proyecto</label>
                        <input type="text" name="TituloProyecto" class="form-control" placeholder="Titulo formal..." required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Area de Investigacion</label>
                        @Html.DropDownList("AreaID", (List<SelectListItem>)ViewBag.Areas, "Seleccione...", new { @class = "form-select", @required = "required" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Descripcion General</label>
                        <textarea name="Descripcion" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Objetivo General</label>
                        <textarea name="Objetivo" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn text-white" style="background-color: #48C9B0;">Registrar Proyecto</button>
                </div>
            }
        </div>
    </div>

    <!-- Tabla de Listado -->
    <h3 style="color: #48C9B0;">Mis Proyectos Registrados</h3>
    <table class="table align-middle mt-3 shadow-sm">
        <thead style="background-color: #48C9B0; color: white;">
            <tr>
                <th>Proyecto</th>
                <th>Estado Actual</th>
                <th>Fecha de Envio</th>
                <th>Observaciones</th>
            </tr>
        </thead>
        <tbody class="bg-white">
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.NombreProyecto</td>
                    <td>
                        @if (item.Estado == "Aprobado")
                        {
                            <span class="badge bg-success">@item.Estado</span>
                        }
                        else if (item.Estado == "Rechazado")
                        {
                            <span class="badge bg-danger">@item.Estado</span>
                        }
                        else if (item.Estado == "Enviado")
                        {
                            <span class="badge bg-warning text-dark">@item.Estado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.Estado</span>
                        }
                    </td>
                    <td>@item.FechaEnvio.ToShortDateString()</td>
                    <td class="text-muted small">Sin observaciones aun</td>
                </tr>
            }
        </tbody>
    </table>
</div>

