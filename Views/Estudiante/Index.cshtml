@model IEnumerable<PrometeoMVC.Models.Proyecto>
@{ ViewBag.Title = "Panel Estudiante"; }

<div class="container mt-4">
    <!-- Formulario de Registro -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-header bg-white py-3">
            <h2 style="color: #48C9B0;">Nueva Propuesta de Proyecto</h2>
            <p class="text-muted small">Completa los campos para iniciar el proceso de evaluación.</p>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Registrar", "Estudiante", FormMethod.Post))
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nombre del Proyecto</label>
                        <input type="text" name="NombreProyecto" class="form-control" placeholder="Ej: Sistema de Gestión..." required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Tipo de Proyecto</label>
                        <select name="Tipo" class="form-select">
                            <option value="I">Individual</option>
                            <option value="G">Grupal</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Título del Proyecto</label>
                        <input type="text" name="TituloProyecto" class="form-control" placeholder="Título formal..." required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Área de Investigación</label>
                        @Html.DropDownList("AreaID", (List<SelectListItem>)ViewBag.Areas, "Seleccione...", new { @class = "form-select", @required = "required" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Descripción General</label>
                        <textarea name="Descripcion" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Objetivo General</label>
                        <textarea name="Objetivo" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn text-white" style="background-color: #48C9B0;">Registrar Proyecto</button>
                </div>
            }
        </div>
    </div>

    <!-- Tabla de Listado -->
    <h3 style="color: #48C9B0;">Mis Proyectos Registrados</h3>
    <table class="table align-middle mt-3 shadow-sm">
        <thead style="background-color: #48C9B0; color: white;">
            <tr>
                <th>Proyecto</th>
                <th>Estado Actual</th>
                <th>Fecha de Envío</th>
                <th>Observaciones</th>
            </tr>
        </thead>
        <tbody class="bg-white">
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.NombreProyecto</td>
                    <td><span class="badge @(item.Estado == "Aprobado" ? "bg-success" : "bg-warning text-dark")">@item.Estado</span></td>
                    <td>@item.FechaEnvio.ToShortDateString()</td>
                    <td class="text-muted small">Sin observaciones aún</td>
                </tr>
            }
        </tbody>
    </table>
</div>

