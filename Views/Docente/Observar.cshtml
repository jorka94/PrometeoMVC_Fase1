@model PrometeoMVC.Models.Proyecto

@{
    ViewBag.Title = "Observar Proyecto";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Observar Proyecto</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f5f5f5; }
        .navbar-prometeo { background-color: #2ab5a0; }
        .btn-prometeo { background-color: #2ab5a0; color: white; border: none; }
        .btn-prometeo:hover { background-color: #239e8b; color: white; }
        h2 { color: #2ab5a0; }
    </style>
</head>
<body>

<nav class="navbar navbar-prometeo navbar-dark px-4 mb-4">
    <span class="navbar-brand fw-bold">Sistema Prometeo</span>
    @Html.ActionLink("Volver", "Index", "Docente", null, new { @class = "btn btn-outline-light btn-sm" })
</nav>

<div class="container-fluid px-4">
<div class="container-fluid px-2" style="width: 90%; max-width: 90%;">

    <h2 class="mb-3">Observar Proyecto</h2>

    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label class="fw-bold">ID:</label>
                <span>@Model.ProyectoID</span>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Nombre del Proyecto:</label>
                <span>@Model.NombreProyecto</span>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Titulo del Proyecto:</label>
                <span>@Model.TituloProyecto</span>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Descripcion:</label>
                <p>@Model.Descripcion</p>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Estado:</label>
                <span>@Model.Estado</span>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Fecha de Envio:</label>
                <span>
                    @if (Model.FechaEnvio.Year > 1)
                    {
                        @Model.FechaEnvio.ToShortDateString()
                    }
                    else
                    {
                        <span>No enviada</span>
                    }
                </span>
            </div>
        </div>
    </div>

    <div class="mt-4">
        @Html.ActionLink("Volver al Panel", "Index", "Docente", null, new { @class = "btn btn-prometeo" })
    </div>

</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
