@model IEnumerable<PrometeoMVC.Models.Proyecto>

@{
    ViewBag.Title = "Panel Docente";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Docente</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f5f5f5; }
        .navbar-prometeo { background-color: #2ab5a0; }
        .btn-prometeo { background-color: #2ab5a0; color: white; border: none; }
        .btn-prometeo:hover { background-color: #239e8b; color: white; }
        .table thead { background-color: #2ab5a0; color: white; }
        h2 { color: #2ab5a0; }
    </style>
</head>
<body>

<nav class="navbar navbar-prometeo navbar-dark px-4 mb-4">
    <span class="navbar-brand fw-bold">Sistema Prometeo</span>
    @Html.ActionLink("Cerrar Sesion", "CerrarSesion", "Admin", null, new { @class = "btn btn-outline-light btn-sm" })
</nav>

<div class="container-fluid px-4">
<div class="container-fluid px-2" style="width: 90%; max-width: 90%;">

        <h2 class="mb-3">Panel Docente</h2>

        <div class="alert alert-info">
            Bienvenido docente: <strong>@Session["Docente"]</strong>
        </div>

        <div class="row mb-4">
            <div class="col-md-3 mb-2">
                <div class="border rounded p-3">
                    <h5>Total</h5>
                    <h3>@ViewBag.Total</h3>
                </div>
            </div>
            <div class="col-md-3 mb-2">
                <div class="border rounded p-3">
                    <h5>Pendientes</h5>
                    <h3>@ViewBag.Pendientes</h3>
                </div>
            </div>
            <div class="col-md-3 mb-2">
                <div class="border rounded p-3">
                    <h5>Aprobados</h5>
                    <h3>@ViewBag.Aprobados</h3>
                </div>
            </div>
            <div class="col-md-3 mb-2">
                <div class="border rounded p-3">
                    <h5>Rechazados</h5>
                    <h3>@ViewBag.Rechazados</h3>
                </div>
            </div>
        </div>

        <form method="get" class="mb-4">
            <div class="row">
                <div class="col-md-4 mb-2">
                    <select name="estado" class="form-control">
                        <option value="">-- Todos los estados --</option>
                        <option value="Pendiente" @(ViewBag.Estado == "Borrador" ? "selected" : "")>Borrador</option>
                        <option value="En revisión" @(ViewBag.Estado == "Enviado" ? "selected" : "")>Enviado</option>
                        <option value="Aprobado" @(ViewBag.Estado == "En revision" ? "selected" : "")>En revision</option>
                        <option value="Rechazado" @(ViewBag.Estado == "Aprobado" ? "selected" : "")>Aprobado</option>
                        <option value="Rechazado" @(ViewBag.Estado == "Rechazado" ? "selected" : "")>Rechazado</option>
                    </select>
                </div>
                <div class="col-md-5 mb-2">
                    <input type="text" name="buscar" class="form-control"
                           value="@ViewBag.Buscar" placeholder="Buscar por nombre o titulo" />
                </div>
                <div class="col-md-3 mb-2">
                    <button type="submit" class="btn btn-prometeo w-100">Filtrar</button>
                </div>
            </div>
        </form>

        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Proyecto</th>
                    <th>Titulo</th>
                    <th>Descripcion</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProyectoID</td>
                        <td>@item.NombreProyecto</td>
                        <td>@item.TituloProyecto</td>
                        <td>@item.Descripcion</td>
                        <td>@item.Estado</td>
                        <td>
                            @if (item.FechaEnvio.Year > 1)
                            {
                                @item.FechaEnvio.ToShortDateString()
                            }
                        </td>
                        <td>
                          <a href="/Docente/Aprobar/@item.ProyectoID" 
                           class="btn btn-sm btn-success me-1"
                           onclick="return confirm('¿Aprobar este proyecto?')">Aprobar</a>
                          <a href="/Docente/Rechazar/@item.ProyectoID" 
                           class="btn btn-sm btn-danger me-1"
                           onclick="return confirm('¿Rechazar este proyecto?')">Rechazar</a>
                          <a href="/Docente/Observar/@item.ProyectoID" 
                          class="btn btn-sm btn-warning">Ver</a>
                         </td>

                    </tr>

                    

                }
            </tbody>
        </table>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>