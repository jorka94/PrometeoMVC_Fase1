@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta name="viewport" content="width=device-width" />

    <title>Login</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

</head>

<body class="bg-light">

    <div class="container mt-5">

        <div class="row justify-content-center">

            <div class="col-md-4">

                <div class="card shadow p-4">

                    <h3 class="text-center mb-4">
                        ¡Bienvenido!
                        <br><h4></h4>favor ingresa con tus credenciales segun perfil!</h4>
                       
                    </h3>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post">

                        <div class="mb-3">

                            <label>
                                <br>
                                Correo
                            </label>

                            <input type="email"
                                   name="correo"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label>
                                Contraseña
                            </label>

                            <input type="password"
                                   name="contrasena"
                                   class="form-control"
                                   required />

                        </div>

                        <button type="submit"
                                class="btn btn-dark w-100">

                            Ingresar

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</body>

</html>