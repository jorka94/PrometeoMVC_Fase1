@{
    ViewBag.Title = "Panel Admin";
}

<div class="container mt-4">

    <div class="card shadow p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h2>
                Panel de Administración - PROMETEO
            </h2>

            <a href="/Admin/CerrarSesion"
               class="btn btn-danger">

                Cerrar Sesión

            </a>

        </div>

        <!-- ar-alxrm: mostramos nombre del admin logueado -->
        <div class="alert alert-dark">

            Bienvenido:
            <strong>
                @Session["Admin"]
            </strong>

        </div>

        <hr />

        <div class="row">

            <div class="col-md-6 mb-3">

                <div class="card border-primary h-100">

                    <div class="card-body">

                        <h4>
                            Gestión de Usuarios
                        </h4>

                        <p>
                            Administración básica de usuarios
                            y control de acceso del sistema.
                        </p>

                        <a href="/Admin/ListaUsuarios"
                           class="btn btn-primary">

                            Ver Usuarios

                        </a>

                    </div>

                </div>

            </div>

            <div class="col-md-6 mb-3">

                <div class="card border-success h-100">

                    <div class="card-body">

                        <h4>
                            Reporte de Proyectos
                        </h4>

                        <p>
                            Consulta de proyectos usando filtros,
                            búsquedas dinámicas y LINQ.
                        </p>

                        <a href="/Admin/ListaProyectos"
                           class="btn btn-success">

                            Ver Reportes

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>