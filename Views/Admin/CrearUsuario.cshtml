@model PrometeoMVC.Models.Usuario

@{
    ViewBag.Title = "Nuevo Usuario";
}

<div class="container mt-4">

    <div class="card shadow p-4">

        <h2 class="mb-4">
            Registrar Nuevo Usuario
        </h2>

        @if (ViewBag.Error != null)
        {

            <div class="alert alert-danger">

                @ViewBag.Error

            </div>

        }

        <!-- ar-alxrm: formulario simple para registrar usuarios -->
        @using (Html.BeginForm())
        {

            <div class="mb-3">

                <label>
                    Nombres
                </label>

                @Html.TextBoxFor(
                    x => x.Nombres,
                    new
                    {
                        @class = "form-control"
                    })

            </div>

            <div class="mb-3">

                <label>
                    Apellidos
                </label>

                @Html.TextBoxFor(
                    x => x.Apellidos,
                    new
                    {
                        @class = "form-control"
                    })

            </div>

            <div class="mb-3">

                <label>
                    Correo
                </label>

                @Html.TextBoxFor(
                    x => x.Correo,
                    new
                    {
                        @class = "form-control"
                    })

            </div>

            <div class="mb-3">

                <label>
                    Contraseña
                </label>

                @Html.PasswordFor(
                    x => x.Contrasena,
                    new
                    {
                        @class = "form-control"
                    })

            </div>

            <div class="mb-4">

                <label>
                    Rol
                </label>

                @Html.DropDownListFor(
                    x => x.Rol,
                    new List<SelectListItem>
                    {
                        new SelectListItem
                        {
                            Text = "Administrador",
                            Value = "Administrador"
                        },

                        new SelectListItem
                        {
                            Text = "Docente",
                            Value = "Docente"
                        },

                        new SelectListItem
                        {
                            Text = "Estudiante",
                            Value = "Estudiante"
                        }

                    },
                    "Seleccione un rol",
                    new
                    {
                        @class = "form-control"
                    })

            </div>

            <button type="submit"
                    class="btn btn-success">

                Guardar Usuario

            </button>

            <a href="/Admin/ListaUsuarios"
               class="btn btn-secondary">

                Volver

            </a>

        }

    </div>

</div>